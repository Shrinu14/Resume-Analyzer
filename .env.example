# Copy to .env and fill in as needed.

# Optional: enables cloud LLM feedback (preferred for deployment, since a
# hosted server usually can't run a local Ollama instance).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: only used if OPENAI_API_KEY is not set. Requires a reachable
# Ollama server.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
